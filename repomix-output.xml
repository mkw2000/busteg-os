typedef enum NavEventType {
    NAV_NONE,
    NAV_UP,
    NAV_DOWN,
    NAV_LEFT,
    NAV_RIGHT,
    NAV_SELECT,
    NAV_BACK,
    NAV_QUIT,
    NAV_POINTER
} NavEventType;

typedef struct NavEvent {
    NavEventType type;
    int x;
