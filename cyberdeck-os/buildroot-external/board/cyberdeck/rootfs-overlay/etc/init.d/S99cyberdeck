#!/bin/sh

case "$1" in
  start)
    export HOME=/root
    export SDL_NOMOUSE=0
    export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-RPI}"
    export SDL_RENDER_DRIVER="${SDL_RENDER_DRIVER:-opengles2}"

    # Ensure the framebuffer console is active so the UI is visible.
    chvt 1 2>/dev/null || true
    dmesg -n 1 2>/dev/null || true
    echo "0 0 0 0" > /proc/sys/kernel/printk 2>/dev/null || true
    printf '\033[?25l' > /dev/tty1 2>/dev/null || true

    attempt=0
    while [ ! -e /dev/fb0 ] && [ "$attempt" -lt 3 ]; do
      sleep 1
      attempt=$((attempt + 1))
    done

    if [ -x /usr/bin/fb-splash ] && [ -e /dev/fb0 ] && [ -e /etc/cyberdeck/bootsplash.ppm ]; then
      /usr/bin/fb-splash /etc/cyberdeck/bootsplash.ppm >/tmp/bootsplash-handoff.log 2>&1 || true
    fi

    # Run the application in the background so init is not blocked.
    (
      cd /etc/cyberdeck || exit 1
      /usr/bin/cyberdeck-os > /tmp/cyberdeck-os.log 2>&1
      echo "cyberdeck-os exited with status $?" >> /tmp/cyberdeck-os.log
    ) &
    ;;

  stop)
    killall cyberdeck-os 2>/dev/null || true
    ;;

  restart)
    "$0" stop
    "$0" start
    ;;

  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
