#!/bin/sh

case "$1" in
  start)
    echo "Starting Cyberdeck OS"

    export HOME=/root
    export SDL_NOMOUSE=0
    export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-RPI}"
    export SDL_RENDER_DRIVER="${SDL_RENDER_DRIVER:-opengles2}"

    /usr/bin/cyberdeck-os &
    ;;

  stop)
    echo "Stopping Cyberdeck OS"
    killall cyberdeck-os 2>/dev/null || true
    ;;

  restart)
    "$0" stop
    "$0" start
    ;;

  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
